  (text "CRSF-Router 8 (RP2350-Zero): 1 Uplink + 7 Ports, je Port GND / +V / TX / RX" (at 12.70 15.24 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid fbd25792-ce35-410d-976e-58194cb4dc45))
  (text "Steckerleiste J1-J8 (2,54 mm, gerade): Pin 1 GND, 2 +V, 3 Router-TX -> RX Geraet, 4 Router-RX <- TX Geraet" (at 12.70 19.05 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 74ac7f8c-6830-4ec6-bd59-f8241bd3b46b))
  (text "VBUS = BEC bis 8,4 V, geht ungeregelt an alle Ports. JPx auftrennen, wenn ein Modul eigene Versorgung hat." (at 12.70 22.86 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 758a4412-d176-4499-905e-7b7c47bf0d0e))
  (text "U2 MCP1703A: Pin 1 GND, 2 VOUT, 3 VIN (SOT-23A). D1 verhindert Rueckstrom, wenn USB steckt." (at 152.40 27.94 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid ac63203b-ee41-4e1c-ad0d-dc0d509ee061))
  (text "R17/R18/C4: VBUS/4,3 an GP26 (bis ca. 14 V messbar). Firmware v0.1.0 erwartet genau diesen Teiler." (at 152.40 31.75 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid be53e4c5-ebed-4538-8e50-a7ae1d390c1c))
  (text "F1-F7: PTC 0,5 A halten / 15 V (z. B. Littelfuse 1206L050/15). Soundmodul mit Verstaerker: ggf. 1,1 A." (at 101.60 210.82 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 97b5c84c-75f1-42ad-866a-9e5e0c70e49b))
  (text "R1-R16: 220 Ohm Schutzwiderstaende in allen Signalleitungen." (at 101.60 214.63 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 6c2763c6-e20d-4d88-b846-18f17304c867))
