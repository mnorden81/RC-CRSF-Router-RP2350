  (text "CRSF-Router 8 (RP2350-Zero): 1 Uplink + 6 Ports, je Port GND / +V / TX / RX" (at 12.70 15.24 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid daae3f9a-0beb-41d7-ae94-c422435f5516))
  (text "Steckerleiste J1-J7 (2,54 mm, gerade): Pin 1 GND, 2 +V, 3 Router-TX -> RX Geraet, 4 Router-RX <- TX Geraet" (at 12.70 19.05 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 575c046b-33f9-46a4-b633-f64d2d8f27ba))
  (text "VBUS = BEC bis 8,4 V, geht ungeregelt an alle Ports. JPx auftrennen, wenn ein Modul eigene Versorgung hat." (at 12.70 22.86 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 6dca986b-a3f0-44c5-99d6-577dd1bf2dc7))
  (text "U2 MCP1703A: Pin 1 GND, 2 VOUT, 3 VIN (SOT-23A). D1 verhindert Rueckstrom, wenn USB steckt." (at 152.40 27.94 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 93069d42-2c7c-45f2-980c-0005c5929ee8))
  (text "R17/R18/C4: VBUS/4,3 an GP26 (bis ca. 14 V messbar). Firmware v0.2.0 erwartet genau diesen Teiler." (at 152.40 31.75 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 626629f9-e9ff-4cea-ba21-db5aa09fbdc4))
  (text "F1-F6: PTC 0,5 A halten / 15 V (z. B. Littelfuse 1206L050/15). Soundmodul mit Verstaerker: ggf. 1,1 A." (at 101.60 210.82 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 36266858-575a-45b1-90fb-7d87792e91fa))
  (text "R1-R14: 220 Ohm Schutzwiderstaende in allen Signalleitungen." (at 101.60 214.63 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid c62e1480-661b-4b05-9ffe-34f058795c10))
